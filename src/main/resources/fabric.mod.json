{
	"schemaVersion": 1,
	"id": "worldpainter",
	"version": "${version}",
	"name": "World Painter",
	"description": "Paint your Minecraft world: biomes, terrain height, surface blocks and water/lava, before the world is created or after. Preview it in 3D and sculpt caves, overhangs and floating islands.",
	"authors": [
		"Daniel"
	],
	"license": "CC0-1.0",
	"icon": "assets/worldpainter/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.daniel.worldpainter.WorldPainter"
		],
		"client": [
			"com.daniel.worldpainter.client.WorldPainterClient"
		]
	},
	"mixins": [
		"worldpainter.mixins.json",
		{
			"config": "worldpainter.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
